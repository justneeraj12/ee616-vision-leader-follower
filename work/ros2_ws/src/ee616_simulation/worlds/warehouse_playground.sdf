<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse_playground">
    <physics name="warehouse_playground_physics" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="warehouse_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="collision">
          <geometry><box><size>24 16 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24 16 0.1</size></box></geometry>
          <material>
            <ambient>0.42 0.44 0.46 1</ambient>
            <diffuse>0.42 0.44 0.46 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_1">
      <static>true</static><pose>-5 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1 2</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_2">
      <static>true</static><pose>0 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1 2</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_3">
      <static>true</static><pose>5 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1 2</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_4">
      <static>true</static><pose>-5 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1 2</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_5">
      <static>true</static><pose>0 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1 2</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
      </link>
    </model>
    <model name="shelf_6">
      <static>true</static><pose>5 -3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3 1 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3 1 2</size></box></geometry><material><ambient>0.18 0.32 0.48 1</ambient><diffuse>0.18 0.32 0.48 1</diffuse></material></visual>
      </link>
    </model>

    <model name="camera_rig">
      <static>true</static>
      <pose>-9 0 0.65 0 0 0</pose>
      <link name="camera_link">
        <sensor name="front_camera" type="camera">
          <topic>/smoke/camera/image</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.2217304764</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>30.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="visual_target">
      <static>true</static>
      <pose>-6 0 0.6 0 0 0</pose>
      <link name="target_link">
        <collision name="collision">
          <geometry><box><size>0.08 0.7 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.7 0.9</size></box></geometry>
          <material><ambient>0.9 0.15 0.05 1</ambient><diffuse>0.9 0.15 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
