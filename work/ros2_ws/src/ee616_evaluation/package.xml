<?xml version="1.0"?>
<package format="3">
  <name>ee616_evaluation</name>
  <version>0.1.0</version>
  <description>Evaluation-only Gazebo ground-truth and metric tools.</description>
  <maintainer email="justneeraj12@users.noreply.github.com">Neeraj Kumar Kanchani</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ee616_perception</exec_depend>
  <exec_depend>ee616_simulation</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
